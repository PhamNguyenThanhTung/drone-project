@@ -9,7 +9,13 @@ PX4_SIM_MODEL=${PX4_SIM_MODEL:=x500_flow}
 
 . ${R}etc/init.d-posix/airframes/4001_gz_x500
 
-echo "Disabling Sim GPS"
-param set-default SYS_HAS_GPS 0
-param set-default SIM_GPS_USED 0
-param set-default EKF2_GPS_CTRL 0
+# The x500_base model already provides a Gazebo NavSat sensor and GZBridge
+# publishes it as sensor_gps. Keep GPS enabled so EKF2 can establish a global
+# position and the project takeoff controller can pass its GPS readiness gate.
+echo "Enabling Sim GPS"
+param set-default SYS_HAS_GPS 1
+param set-default SIM_GPS_USED 10
+param set-default EKF2_GPS_CTRL 7
+# The project uses the onboard MAVLink client on UDP 14540 and may run
+# without QGroundControl. Do not make a GCS link a hard arming prerequisite.
+param set-default NAV_DLL_ACT 0
