<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="person_tracking_path">
    <!-- 1. Cấu hình Physics: max_step_size 1ms, real_time_factor 1.0 -->
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 2. Các Plugin gz-sim cốt lõi -->
    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>

    <!-- 3. Scene & Sky & Ánh sáng môi trường -->
    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.7 0.85 1.0 1.0</background>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <!-- 4. Toạ độ địa lý (GPS/NavSat cho ArduPilot SITL) -->
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <!-- 5. Nguồn sáng mặt trời (Directional Sun Light - đủ sáng cho YOLO Camera) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- 6. Trục toạ độ tham chiếu + GPS NavSat Sensor cho SITL -->
    <model name="axes">
      <static>1</static>
      <link name="link">
        <visual name="r">
          <cast_shadows>0</cast_shadows>
          <pose>5 0 0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>10 0.05 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 0.8</ambient>
            <diffuse>1 0 0 0.8</diffuse>
            <emissive>1 0 0 0.8</emissive>
          </material>
        </visual>
        <visual name="g">
          <cast_shadows>0</cast_shadows>
          <pose>0 5 0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 10 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0 1 0 0.8</ambient>
            <diffuse>0 1 0 0.8</diffuse>
            <emissive>0 1 0 0.8</emissive>
          </material>
        </visual>
        <visual name="b">
          <cast_shadows>0</cast_shadows>
          <pose>0 0 5.0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 10</size>
            </box>
          </geometry>
          <material>
            <ambient>0 0 1 0.8</ambient>
            <diffuse>0 0 1 0.8</diffuse>
            <emissive>0 0 1 0.8</emissive>
          </material>
        </visual>
        <sensor name="navsat_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>1</update_rate>
        </sensor>
      </link>
    </model>

    <!-- 7. Mặt đất bãi cỏ rộng (Ground Grass Plane >= 120x120m) -->
    <model name="ground_grass">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <!-- A finite box is used for ODE/DART collision. A collision
               plane remains unbounded even when <size> is specified and
               triggers the hash-space AABB overflow in this world. -->
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>140 140 0.10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>140 140</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.48 0.16 1.0</ambient>
            <diffuse>0.28 0.55 0.20 1.0</diffuse>
            <specular>0.05 0.08 0.05 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 8. Con đường / Vỉa hè bê tông dạng Zic-Zac trong công viên (Park Walkway) -->
    <model name="park_walkway">
      <static>true</static>
      <link name="walkway_link">
        <!-- Đoạn 1: từ (0, 5) đến (10, 5) -->
        <visual name="segment_1_visual">
          <pose>5.0 5.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>12.5 2.5 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.62 0.62 0.62 1.0</ambient>
            <diffuse>0.68 0.68 0.68 1.0</diffuse>
            <specular>0.15 0.15 0.15 1.0</specular>
          </material>
        </visual>
        <collision name="segment_1_col">
          <pose>5.0 5.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>12.5 2.5 0.03</size>
            </box>
          </geometry>
        </collision>

        <!-- Đoạn 2: từ (10, 5) đến (10, 15) -->
        <visual name="segment_2_visual">
          <pose>10.0 10.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 12.5 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.60 0.60 0.60 1.0</ambient>
            <diffuse>0.66 0.66 0.66 1.0</diffuse>
            <specular>0.15 0.15 0.15 1.0</specular>
          </material>
        </visual>
        <collision name="segment_2_col">
          <pose>10.0 10.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 12.5 0.03</size>
            </box>
          </geometry>
        </collision>

        <!-- Đoạn 3: từ (10, 15) đến (20, 15) -->
        <visual name="segment_3_visual">
          <pose>15.0 15.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>12.5 2.5 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.62 0.62 0.62 1.0</ambient>
            <diffuse>0.68 0.68 0.68 1.0</diffuse>
            <specular>0.15 0.15 0.15 1.0</specular>
          </material>
        </visual>
        <collision name="segment_3_col">
          <pose>15.0 15.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>12.5 2.5 0.03</size>
            </box>
          </geometry>
        </collision>

        <!-- Đoạn 4: từ (20, 15) đến (20, 5) -->
        <visual name="segment_4_visual">
          <pose>20.0 10.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 12.5 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.60 0.60 0.60 1.0</ambient>
            <diffuse>0.66 0.66 0.66 1.0</diffuse>
            <specular>0.15 0.15 0.15 1.0</specular>
          </material>
        </visual>
        <collision name="segment_4_col">
          <pose>20.0 10.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 12.5 0.03</size>
            </box>
          </geometry>
        </collision>

        <!-- Đoạn 5: từ (20, 5) đến (30, 5) -->
        <visual name="segment_5_visual">
          <pose>25.0 5.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>12.5 2.5 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.62 0.62 0.62 1.0</ambient>
            <diffuse>0.68 0.68 0.68 1.0</diffuse>
            <specular>0.15 0.15 0.15 1.0</specular>
          </material>
        </visual>
        <collision name="segment_5_col">
          <pose>25.0 5.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>12.5 2.5 0.03</size>
            </box>
          </geometry>
        </collision>

        <!-- Đoạn 6: từ (30, 5) đến (30, 15) -->
        <visual name="segment_6_visual">
          <pose>30.0 10.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 12.5 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.60 0.60 0.60 1.0</ambient>
            <diffuse>0.66 0.66 0.66 1.0</diffuse>
            <specular>0.15 0.15 0.15 1.0</specular>
          </material>
        </visual>
        <collision name="segment_6_col">
          <pose>30.0 10.0 0.015 0 0 0</pose>
          <geometry>
            <box>
              <size>2.5 12.5 0.03</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 9. Cây cối hai bên đường công viên (Park Trees & Scenery) -->
    <include>
      <name>oak_tree_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>5.0 9.5 0 0 0 0</pose>
    </include>
    <include>
      <name>oak_tree_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>5.0 0.5 0 0 0 0.8</pose>
    </include>
    <include>
      <name>oak_tree_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>15.0 9.5 0 0 0 1.5</pose>
    </include>
    <include>
      <name>pine_tree_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>6.0 19.5 0 0 0 0.3</pose>
    </include>
    <include>
      <name>pine_tree_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>20.0 19.5 0 0 0 0.6</pose>
    </include>
    <include>
      <name>oak_tree_4</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>25.0 0.5 0 0 0 2.1</pose>
    </include>
    <include>
      <name>pine_tree_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pine Tree</uri>
      <pose>35.0 0.5 0 0 0 1.1</pose>
    </include>
    <include>
      <name>oak_tree_5</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Oak tree</uri>
      <pose>35.0 19.5 0 0 0 0.4</pose>
    </include>

    <!-- 10. Drone Iris với Gimbal + Camera (Sẵn sàng bay test YOLO + Gimbal Tracking) -->
    <include>
      <uri>model://iris_with_gimbal</uri>
      <pose degrees="true">-2.0 5.0 0.35 0 0 0</pose>
    </include>

    <!-- 11. Người đi bộ (Actor: walking_person) có skeleton animation đi bộ thực -->
    <actor name="walking_person">
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/mingfei/models/actor/1/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>

      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/mingfei/models/actor/1/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>

      <script>
        <loop>true</loop>
        <!-- Give SITL time to arm, take off and settle before tracking starts. -->
        <delay_start>30.0</delay_start>
        <auto_start>true</auto_start>

        <!-- Quỹ đạo di chuyển (Trajectory) khớp chính xác 100% với đường đi vỉa hè -->
        <!-- Tổng quãng đường khứ hồi: 120m. Vận tốc đi bộ: ~1.11 m/s. Chu kỳ lặp: 121s -->
        <trajectory id="0" type="walk">
          <!-- === LƯỢT ĐI (FORWARD): WP0 -> WP1 -> WP2 -> WP3 -> WP4 -> WP5 -> WP6 === -->
          <!-- 1. Bắt đầu tại WP0 (0, 5), hướng Đông (yaw = 0.0) -->
          <waypoint>
            <time>0.0</time>
            <pose>0.0 5.0 0.8891414 0 0 0.0</pose>
          </waypoint>
          <!-- 2. Đến WP1 (10, 5), kết thúc đoạn 1 -->
          <waypoint>
            <time>9.0</time>
            <pose>10.0 5.0 0.8891414 0 0 0.0</pose>
          </waypoint>
          <!-- 3. Rẽ trái 90 độ tại WP1 để hướng Bắc (yaw = 1.5708) -->
          <waypoint>
            <time>10.0</time>
            <pose>10.0 5.0 0.8891414 0 0 1.5708</pose>
          </waypoint>
          <!-- 4. Đến WP2 (10, 15), kết thúc đoạn 2 -->
          <waypoint>
            <time>19.0</time>
            <pose>10.0 15.0 0.8891414 0 0 1.5708</pose>
          </waypoint>
          <!-- 5. Rẽ phải 90 độ tại WP2 để hướng Đông (yaw = 0.0) -->
          <waypoint>
            <time>20.0</time>
            <pose>10.0 15.0 0.8891414 0 0 0.0</pose>
          </waypoint>
          <!-- 6. Đến WP3 (20, 15), kết thúc đoạn 3 -->
          <waypoint>
            <time>29.0</time>
            <pose>20.0 15.0 0.8891414 0 0 0.0</pose>
          </waypoint>
          <!-- 7. Rẽ phải 90 độ tại WP3 để hướng Nam (yaw = -1.5708) -->
          <waypoint>
            <time>30.0</time>
            <pose>20.0 15.0 0.8891414 0 0 -1.5708</pose>
          </waypoint>
          <!-- 8. Đến WP4 (20, 5), kết thúc đoạn 4 -->
          <waypoint>
            <time>39.0</time>
            <pose>20.0 5.0 0.8891414 0 0 -1.5708</pose>
          </waypoint>
          <!-- 9. Rẽ trái 90 độ tại WP4 để hướng Đông (yaw = 0.0) -->
          <waypoint>
            <time>40.0</time>
            <pose>20.0 5.0 0.8891414 0 0 0.0</pose>
          </waypoint>
          <!-- 10. Đến WP5 (30, 5), kết thúc đoạn 5 -->
          <waypoint>
            <time>49.0</time>
            <pose>30.0 5.0 0.8891414 0 0 0.0</pose>
          </waypoint>
          <!-- 11. Rẽ trái 90 độ tại WP5 để hướng Bắc (yaw = 1.5708) -->
          <waypoint>
            <time>50.0</time>
            <pose>30.0 5.0 0.8891414 0 0 1.5708</pose>
          </waypoint>
          <!-- 12. Đến WP6 (30, 15), điểm cuối lượt đi -->
          <waypoint>
            <time>59.0</time>
            <pose>30.0 15.0 0.8891414 0 0 1.5708</pose>
          </waypoint>

          <!-- === QUAY ĐẦU TẠI WP6 ĐỂ ĐI VỀ (U-TURN) === -->
          <!-- 13. Quay 180 độ tại WP6 (30, 15) sang hướng Nam (yaw = -1.5708) -->
          <waypoint>
            <time>61.0</time>
            <pose>30.0 15.0 0.8891414 0 0 -1.5708</pose>
          </waypoint>

          <!-- === LƯỢT VỀ (RETURN): WP6 -> WP5 -> WP4 -> WP3 -> WP2 -> WP1 -> WP0 === -->
          <!-- 14. Về lại WP5 (30, 5) -->
          <waypoint>
            <time>70.0</time>
            <pose>30.0 5.0 0.8891414 0 0 -1.5708</pose>
          </waypoint>
          <!-- 15. Rẽ phải 90 độ tại WP5 để hướng Tây (yaw = -3.14159) -->
          <waypoint>
            <time>71.0</time>
            <pose>30.0 5.0 0.8891414 0 0 -3.14159</pose>
          </waypoint>
          <!-- 16. Về lại WP4 (20, 5) -->
          <waypoint>
            <time>80.0</time>
            <pose>20.0 5.0 0.8891414 0 0 -3.14159</pose>
          </waypoint>
          <!-- 17. Rẽ phải 90 độ tại WP4 để hướng Bắc (yaw = -4.71239) -->
          <waypoint>
            <time>81.0</time>
            <pose>20.0 5.0 0.8891414 0 0 -4.71239</pose>
          </waypoint>
          <!-- 18. Về lại WP3 (20, 15) -->
          <waypoint>
            <time>90.0</time>
            <pose>20.0 15.0 0.8891414 0 0 -4.71239</pose>
          </waypoint>
          <!-- 19. Rẽ trái 90 độ tại WP3 để hướng Tây (yaw = -3.14159) -->
          <waypoint>
            <time>91.0</time>
            <pose>20.0 15.0 0.8891414 0 0 -3.14159</pose>
          </waypoint>
          <!-- 20. Về lại WP2 (10, 15) -->
          <waypoint>
            <time>100.0</time>
            <pose>10.0 15.0 0.8891414 0 0 -3.14159</pose>
          </waypoint>
          <!-- 21. Rẽ trái 90 độ tại WP2 để hướng Nam (yaw = -1.5708) -->
          <waypoint>
            <time>101.0</time>
            <pose>10.0 15.0 0.8891414 0 0 -1.5708</pose>
          </waypoint>
          <!-- 22. Về lại WP1 (10, 5) -->
          <waypoint>
            <time>110.0</time>
            <pose>10.0 5.0 0.8891414 0 0 -1.5708</pose>
          </waypoint>
          <!-- 23. Rẽ phải 90 độ tại WP1 để hướng Tây (yaw = -3.14159) -->
          <waypoint>
            <time>111.0</time>
            <pose>10.0 5.0 0.8891414 0 0 -3.14159</pose>
          </waypoint>
          <!-- 24. Về đến điểm xuất phát WP0 (0, 5) -->
          <waypoint>
            <time>120.0</time>
            <pose>0.0 5.0 0.8891414 0 0 -3.14159</pose>
          </waypoint>
          <!-- 25. Quay lại hướng Đông (yaw = 0.0) để bắt đầu vòng lặp tiếp theo -->
          <waypoint>
            <time>121.0</time>
            <pose>0.0 5.0 0.8891414 0 0 0.0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
</sdf>
