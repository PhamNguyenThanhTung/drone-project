<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="person_tracking_long_path">
    <!-- 1. Cấu hình Physics: max_step_size 4ms, real_time_factor 1.0 -->
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- 2. Các Plugin gz-sim cốt lõi -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- 3. Scene & Sky & Ánh sáng môi trường -->
    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.7 0.85 1.0 1.0</background>
      <sky>
        <clouds>
          <speed>12</speed>
        </clouds>
      </sky>
    </scene>

    <!-- 4. Toạ độ địa lý (GPS/NavSat) -->
    <spherical_coordinates>
      <latitude_deg>47.397742</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>488.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    <!-- 5. Nguồn sáng mặt trời -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 50 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- 6. Ground Plane cỏ xanh 140x140m -->
    <model name="ground_grass">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>140 140</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>140 140</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.48 0.16 1.0</ambient>
            <diffuse>0.28 0.55 0.20 1.0</diffuse>
            <specular>0.05 0.08 0.05 1.0</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 7. Hệ thống đường lát đá đi dạo trong công viên dài 70m -->
    <model name="paved_walkway_system">
      <static>true</static>
      <link name="path_link">
        <!-- Đoạn 1: (0, 0.5) -> (12, 0.5) -->
        <visual name="seg1_vis">
          <pose>6.0 0.5 0.015 0 0 0</pose>
          <geometry><box><size>14.0 2.5 0.03</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1.0</ambient><diffuse>0.68 0.68 0.68 1.0</diffuse></material>
        </visual>
        <!-- Đoạn 2: (12, 0.5) -> (12, 10.5) Rẽ Trái -->
        <visual name="seg2_vis">
          <pose>12.0 5.5 0.015 0 0 0</pose>
          <geometry><box><size>2.5 12.5 0.03</size></box></geometry>
          <material><ambient>0.60 0.60 0.60 1.0</ambient><diffuse>0.66 0.66 0.66 1.0</diffuse></material>
        </visual>
        <!-- Đoạn 3: (12, 10.5) -> (22, 10.5) Rẽ Phải -->
        <visual name="seg3_vis">
          <pose>17.0 10.5 0.015 0 0 0</pose>
          <geometry><box><size>12.5 2.5 0.03</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1.0</ambient><diffuse>0.68 0.68 0.68 1.0</diffuse></material>
        </visual>
        <!-- Đoạn 4: (22, 10.5) -> (22, -3.5) Rẽ Phải -->
        <visual name="seg4_vis">
          <pose>22.0 3.5 0.015 0 0 0</pose>
          <geometry><box><size>2.5 16.5 0.03</size></box></geometry>
          <material><ambient>0.60 0.60 0.60 1.0</ambient><diffuse>0.66 0.66 0.66 1.0</diffuse></material>
        </visual>
        <!-- Đoạn 5: (22, -3.5) -> (32, -3.5) Rẽ Trái -->
        <visual name="seg5_vis">
          <pose>27.0 -3.5 0.015 0 0 0</pose>
          <geometry><box><size>12.5 2.5 0.03</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1.0</ambient><diffuse>0.68 0.68 0.68 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 8. Drone Spawn Position (Origin) -->
    <include>
      <uri>model://x500</uri>
      <name>x500_0</name>
      <pose>0 0 0.24 0 0 0</pose>
    </include>

    <!-- ================================================================= -->
    <!-- 9. TARGET CHÍNH: Person A (walking_person)                        -->
    <!-- Lộ trình dài 70m: Đi thẳng -> Rẽ trái -> Rẽ phải -> Rẽ phải -> Rẽ trái -> Quay đầu 180° -->
    <!-- ================================================================= -->
    <actor name="walking_person">
      <skin>
        <filename>model://pedestrian_blue/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>model://pedestrian_blue/meshes/walk.dae</filename>
        <scale>1.0</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>20.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk">
          <!-- Xuất phát tại (5.0, 0.5) ngay trước camera drone sau khi drone đã ổn định ở 3.8m -->
          <!-- Đoạn 1: Đi thẳng 7m từ (5, 0.5) đến (12, 0.5) hướng Đông (yaw = 0) -->
          <waypoint>
            <time>0.0</time>
            <pose>5.0 0.5 0.8891414 0 0 0.0</pose>
          </waypoint>
          <waypoint>
            <time>7.0</time>
            <pose>12.0 0.5 0.8891414 0 0 0.0</pose>
          </waypoint>
          <!-- Rẽ Trái 90° tại (12, 0.5) sang hướng Bắc (yaw = 1.5708) -->
          <waypoint>
            <time>8.0</time>
            <pose>12.0 0.5 0.8891414 0 0 1.5708</pose>
          </waypoint>
          <!-- Đoạn 2: Đi thẳng 10m từ (12, 0.5) đến (12, 10.5) hướng Bắc -->
          <waypoint>
            <time>18.0</time>
            <pose>12.0 10.5 0.8891414 0 0 1.5708</pose>
          </waypoint>
          <!-- Rẽ Phải 90° tại (12, 10.5) sang hướng Đông (yaw = 0.0) -->
          <waypoint>
            <time>19.0</time>
            <pose>12.0 10.5 0.8891414 0 0 0.0</pose>
          </waypoint>
          <!-- Đoạn 3: Đi thẳng 10m từ (12, 10.5) đến (22, 10.5) hướng Đông -->
          <waypoint>
            <time>29.0</time>
            <pose>22.0 10.5 0.8891414 0 0 0.0</pose>
          </waypoint>
          <!-- Rẽ Phải 90° tại (22, 10.5) sang hướng Nam (yaw = -1.5708) -->
          <waypoint>
            <time>30.0</time>
            <pose>22.0 10.5 0.8891414 0 0 -1.5708</pose>
          </waypoint>
          <!-- Đoạn 4: Đi thẳng 14m từ (22, 10.5) đến (22, -3.5) hướng Nam -->
          <waypoint>
            <time>44.0</time>
            <pose>22.0 -3.5 0.8891414 0 0 -1.5708</pose>
          </waypoint>
          <!-- Rẽ Trái 90° tại (22, -3.5) sang hướng Đông (yaw = 0.0) -->
          <waypoint>
            <time>45.0</time>
            <pose>22.0 -3.5 0.8891414 0 0 0.0</pose>
          </waypoint>
          <!-- Đoạn 5: Đi thẳng 10m từ (22, -3.5) đến (32, -3.5) hướng Đông -->
          <waypoint>
            <time>55.0</time>
            <pose>32.0 -3.5 0.8891414 0 0 0.0</pose>
          </waypoint>
          <!-- Quay đầu 180° tại (32, -3.5) (yaw = 3.14159) -->
          <waypoint>
            <time>57.0</time>
            <pose>32.0 -3.5 0.8891414 0 0 3.14159</pose>
          </waypoint>
          <!-- LƯỢT VỀ: Đi ngược lại về (22, -3.5) -->
          <waypoint>
            <time>67.0</time>
            <pose>22.0 -3.5 0.8891414 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>68.0</time>
            <pose>22.0 -3.5 0.8891414 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>82.0</time>
            <pose>22.0 10.5 0.8891414 0 0 1.5708</pose>
          </waypoint>
          <waypoint>
            <time>83.0</time>
            <pose>22.0 10.5 0.8891414 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>93.0</time>
            <pose>12.0 10.5 0.8891414 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>94.0</time>
            <pose>12.0 10.5 0.8891414 0 0 -1.5708</pose>
          </waypoint>
          <waypoint>
            <time>104.0</time>
            <pose>12.0 0.5 0.8891414 0 0 -1.5708</pose>
          </waypoint>
          <waypoint>
            <time>105.0</time>
            <pose>12.0 0.5 0.8891414 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>112.0</time>
            <pose>5.0 0.5 0.8891414 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>113.0</time>
            <pose>5.0 0.5 0.8891414 0 0 0.0</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>
  </world>
</sdf>
